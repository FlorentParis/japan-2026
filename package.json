{
  "name": "travel-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://FlorentParis.github.io/japan-2026/",
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "icones": "node scripts/icones.mjs",
    "qa": "vite build --config scripts/qa.vite.config.ts && node .qa/donnees.mjs && node .qa/rendu.mjs",
    "qa:carte": "node scripts/qa-carte.mjs",
    "qa:hors-ligne": "node scripts/qa-hors-ligne.mjs",
    "qa:tiroir": "node scripts/qa-tiroir.mjs",
    "qa:photos": "node scripts/qa-photos.mjs",
    "photos": "vite build --config scripts/qa.vite.config.ts && node .qa/photos.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
